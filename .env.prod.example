APP_VERSION=1.0.0

# Datenbank
POSTGRES_USER=onduty
POSTGRES_DB=onduty
SERVICE_PASSWORD_POSTGRES=<sicheres-zufalls-passwort>  # openssl rand -hex 32

# App-Secrets
SERVICE_PASSWORD_BETTERAUTH=<sicheres-zufalls-passwort>  # openssl rand -hex 32
SERVICE_PASSWORD_ADMIN=<admin-passwort>

# App-Konfiguration
ORG_NAME=Feuerwehr Musterstadt
OIDC_PROVIDER=keycloak
OIDC_CLIENT_ID=on-duty
OIDC_CLIENT_SECRET=<client-secret>
OIDC_APP_URL=https://on-duty.example.com  # kein trailing /

# Optional: Fehlererfassung (Sentry-kompatibel: Bugsink, GlitchTip, Sentry)
# SENTRY_DSN=https://<key>@<host>/<project>
# ERROR_TRACKER_URL=https://<host>  # Link unter Admin → Konfiguration

# Optional: Traces/Metriken per OpenTelemetry (OTLP/HTTP, z. B. OpenObserve)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<host>/api/default
# OPENOBSERVE_USER=
# OPENOBSERVE_PASSWORD=
# OTEL_EXPORTER_OTLP_HEADERS=   # überschreibt den Basic-Header aus USER/PASSWORD
# OTEL_TRACES_SAMPLER_ARG=1     # Anteil gesampelter Traces (0..1), Standard 1

# Optional (Defaults gelten wenn nicht gesetzt)
# SESSION_LIFETIME=7d
# BACKUP_STATUS_MAX_AGE_HOURS=26
# ANNIVERSARY_CUTOFF=01-06