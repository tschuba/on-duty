{
  "name": "on-duty",
  "version": "0.13.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"node --env-file=.env --import=tsx/esm --watch src/index.tsx\" \"tailwindcss -i src/styles/app.css -o public/css/app.css --watch\"",
    "build": "tsup && tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env --import=tsx/esm scripts/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:studio": "drizzle-kit studio",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-fonts.mjs && node scripts/copy-htmx.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@hono/node-server": "^2.1.5",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "n2words": "^6.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "postgres": "^3.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/oswald": "^5.1.0",
    "@tailwindcss/cli": "^4.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "drizzle-kit": "^0.31.11",
    "heroicons": "^2.2.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
