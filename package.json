{
  "name": "on-duty",
  "version": "0.82.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": "github:tschuba/on-duty",
  "homepage": "https://github.com/tschuba/on-duty",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"LOG_FORMAT=pretty NODE_EXTRA_CA_CERTS=.dev-stack/caddy-root.crt node --env-file=.env --env-file-if-exists=.env.dev-stack --import=tsx/esm --import=./src/lib/otel.ts --watch src/index.tsx\" \"tailwindcss -i src/styles/app.css -o public/css/app.css --watch\"",
    "build": "node scripts/build-browser-sentry.mjs && tsup && tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "start": "node dist/index.js",
    "stack:up": "scripts/dev-stack.sh up",
    "stack:up:errors": "scripts/dev-stack.sh up --with-errors",
    "stack:down": "scripts/dev-stack.sh down",
    "stack:reset": "scripts/dev-stack.sh reset",
    "stack:trust": "scripts/dev-stack.sh trust",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.dev-stack --import=tsx/esm scripts/seed.ts",
    "ops:pseudonym": "node --env-file-if-exists=.env --import=tsx/esm scripts/user-pseudonym.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:studio": "drizzle-kit studio",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:favicons": "node scripts/build-favicons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-fonts.mjs && node scripts/copy-htmx.mjs && node scripts/copy-calendar.mjs && node scripts/copy-trix.mjs && node scripts/build-browser-sentry.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@sentry/node": "^11.9.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "import-in-the-middle": "^3.5.3",
    "n2words": "^6.3.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sanitize-html": "^2.18.1",
    "trix": "^2.1.19",
    "vanilla-calendar-pro": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/oswald": "^5.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/browser": "^11.9.0",
    "@tabler/icons": "^3.50.0",
    "@tailwindcss/cli": "^4.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
