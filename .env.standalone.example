APP_VERSION=latest

# Coolify: Domains, Passwörter und Secrets (SERVICE_FQDN_*, SERVICE_PASSWORD_*)
# werden von Coolify aus docker-compose.standalone.yml erzeugt — hier nichts
# dafür setzen. Domains in der Coolify-UI eintragen:
#   app           -> https://on-duty.example.com
#   zitadel       -> https://auth.example.com
#   zitadel-login -> https://login.example.com   (eigene Domain, ohne Pfad)
ORG_NAME=Feuerwehr Musterstadt

# OIDC — normally leave empty: on the first `up` the init container zitadel-init
# creates the project + OIDC application in Zitadel. Only set these if the
# application was created manually (see docs/standalone-deployment.md).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# SMTP (optional) — used by on-duty AND registered in Zitadel during first setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Backup-Überwachung (optional): Stunden ohne erfolgreiches Backup bis zur Warnung.
# BACKUP_STATUS_MAX_AGE_HOURS=26
