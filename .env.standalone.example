APP_VERSION=latest

# Domains — je eine Subdomain für App und Zitadel (kein Subpath-Betrieb, siehe
# 08_Standalone-Deployment.md). Beide müssen per DNS auf diesen Host zeigen,
# Ports 80+443 müssen von außen erreichbar sein (Caddy holt automatisch
# Let's-Encrypt-Zertifikate).
APP_DOMAIN=app.example.com
ZITADEL_DOMAIN=auth.example.com

# Datenbank (onduty)
POSTGRES_USER=onduty
POSTGRES_DB=onduty
SERVICE_PASSWORD_POSTGRES=<sicheres-zufalls-passwort>  # openssl rand -hex 32

# Datenbank (zitadel) — eigener, nicht-privilegierter User/DB auf derselben
# Postgres-Instanz
ZITADEL_DB_USER=zitadel
ZITADEL_DB_NAME=zitadel
SERVICE_PASSWORD_ZITADEL_DB=<sicheres-zufalls-passwort>  # openssl rand -hex 32

# App-Secrets (on-duty)
SERVICE_PASSWORD_BETTERAUTH=<sicheres-zufalls-passwort>  # openssl rand -hex 32
SERVICE_PASSWORD_ADMIN=<admin-passwort>
ORG_NAME=Feuerwehr Musterstadt

# Zitadel — Ersteinrichtung (automatisch: nur Org + Admin-User)
ZITADEL_MASTERKEY=<exakt-32-zeichen>              # openssl rand -hex 16
ZITADEL_SESSION_COOKIE_SECRET=<mind-32-zeichen>   # openssl rand -base64 32
ZITADEL_ADMIN_USERNAME=zitadel-admin
SERVICE_PASSWORD_ZITADEL_ADMIN=<admin-passwort>

# OIDC — erst nach dem manuellen Zitadel-Setup-Schritt befüllbar
# (Projekt + OIDC-Application in der Zitadel-Console anlegen, siehe
# docs/standalone-deployment.md). Deployment ist daher zweistufig.
OIDC_CLIENT_ID=<nach-manuellem-zitadel-setup>
OIDC_CLIENT_SECRET=<nach-manuellem-zitadel-setup>
